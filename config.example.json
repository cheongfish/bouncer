{
  "source_dirs": [],
  "context_dirs": [
    ".bouncer/context"
  ],
  "graphify": {
    "enabled": true,
    "test_dirs": [
      "test"
    ],
    "exclude_dirs": [
      "scripts/lib"
    ]
  },
  "distill": {
    "routing_enabled": false,
    "max_bytes": 6144
  },
  "verify": "npm test",
  "verify_allowlist": [
    "npm",
    "npx",
    "node",
    "pnpm",
    "yarn",
    "bun",
    "deno",
    "make",
    "python",
    "python3",
    "pytest",
    "go",
    "cargo",
    "true",
    "false"
  ],
  "base_branch": "main",
  "autonomy": "auto",
  "pr": {
    "draft": true,
    "base": "main"
  },
  "subagents": {
    "claude": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit",
      "bouncer-debugger": "inherit",
      "bouncer-context-reviewer": "inherit"
    },
    "cursor": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit",
      "bouncer-debugger": "inherit",
      "bouncer-context-reviewer": "inherit"
    },
    "codex": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit",
      "bouncer-debugger": "inherit",
      "bouncer-context-reviewer": "inherit"
    }
  }
}
