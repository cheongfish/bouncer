+test('executeVerify starts a heartbeat worker with the default interval and stops it after a fast command', () => {
+  const calls = [];
+  const terminateCalls = [];
+  const fakeWorker = { intervalMs: undefined, terminate: () => terminateCalls.push(true) };
+  const createHeartbeatWorker = (data) => {
+    calls.push(data);
+    return fakeWorker;
+  };
+
+  const result = executeVerify('node -e "process.exit(0)"', {
+    cwd: process.cwd(),
+    exec: () => ({ stdout: 'ok\n', stderr: '' }),
+    createHeartbeatWorker,
+  });
+
+  assert.deepStrictEqual(result, { ok: true, exitCode: 0, output: 'ok' });
+  assert.deepStrictEqual(calls, [{ intervalMs: DEFAULT_SLOW_VERIFY_HEARTBEAT_MS }]);
+  assert.strictEqual(terminateCalls.length, 1);
+});
+
+test('executeVerify passes a custom heartbeatIntervalMs through to the worker factory', () => {
+  const calls = [];
+  const createHeartbeatWorker = (data) => {
+    calls.push(data);
+    return { terminate: () => {} };
+  };
+
+  executeVerify('node -e "process.exit(0)"', {
+    cwd: process.cwd(),
+    exec: () => ({ stdout: '', stderr: '' }),
+    heartbeatIntervalMs: 5,
+    createHeartbeatWorker,
+  });
+
+  assert.deepStrictEqual(calls, [{ intervalMs: 5 }]);
+});
+
+test('executeVerify still terminates the heartbeat worker when the command fails', () => {
+  const terminateCalls = [];
+  const createHeartbeatWorker = () => ({ terminate: () => terminateCalls.push(true) });
+  const failure = new Error('command failed');
+  failure.status = 3;
+  failure.stdout = '';
+  failure.stderr = 'boom\n';
+
+  const result = executeVerify('node -e "process.exit(3)"', {
+    cwd: process.cwd(),
+    exec: () => { throw failure; },
+    createHeartbeatWorker,
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.exitCode, 3);
+  assert.strictEqual(terminateCalls.length, 1);
+});
+
+test('executeVerify does not let a heartbeat worker creation failure break verification', () => {
+  const result = executeVerify('node -e "process.exit(0)"', {
+    cwd: process.cwd(),
+    exec: () => ({ stdout: 'fine\n', stderr: '' }),
+    createHeartbeatWorker: () => { throw new Error('worker unavailable'); },
+  });
+
+  assert.deepStrictEqual(result, { ok: true, exitCode: 0, output: 'fine' });
