+// 프로세스 안에서 process.stderr.write를 가로채는 방식으로는 증명할 수 없다
+// — 그 방식은 결국 메인 스레드 이벤트 루프가 돌아야 전달되는 가상 파이프에
+// 의존하기 때문이다(그래서 프로덕션 코드는 fs.writeSync(2, ...)로 fd에 직접
+// 쓴다). 진짜 blocking 상황을 재현하려면 별도 OS 프로세스를 띄워 그 프로세스의
+// 실제 stderr fd를 파이프로 받아야 한다.
+function runExecuteVerifyInChildProcess(command, heartbeatIntervalMs) {
+  const { spawnSync } = require('node:child_process');
+  const script = `
+    const { executeVerify } = require(${JSON.stringify(path.join(__dirname, '..', 'scripts/lib/verification.js'))});
+    const result = executeVerify(${JSON.stringify(command)}, {
+      cwd: process.cwd(),
+      heartbeatIntervalMs: ${heartbeatIntervalMs},
+    });
+    process.exitCode = result.ok ? 0 : 1;
+  `;
+  // execFileSync만 쓰면 exit code 0(성공)일 때 stderr를 돌려받을 방법이 없다
+  // (실패했을 때 error.stderr로만 노출됨) — spawnSync는 종료 코드와 무관하게
+  // stdout/stderr를 항상 함께 돌려준다.
+  const proc = spawnSync(process.execPath, ['-e', script], { encoding: 'utf8' });
+  return proc.stderr || '';
+}
