+    { code: 'VERIFY_COMMAND_INVALID' },
+  );
+});
+
+test('dryRunVerification does not require verification.md to exist', () => {
+  const repo = fs.mkdtempSync(path.join(os.tmpdir(), 'bouncer-verification-dryrun-'));
+  fs.mkdirSync(path.join(repo, '.bouncer'), { recursive: true });
+  fs.writeFileSync(path.join(repo, '.bouncer/config.json'), JSON.stringify({ verify: 'npm test' }));
+  writeTasks(repo, undefined);
+  // 이 repo에는 tasks/001/verification.md가 없다 — runVerification이면
+  // VERIFY_DOCUMENT_MISSING이지만, dry-run은 실행/기록을 하지 않으므로
+  // 문서 부재가 실패 사유가 아니다.
+  const resolved = dryRunVerification({ repoRoot: repo, blueprintDir: BP_REL });
+  assert.strictEqual(resolved.command, 'npm test');
+});
