+test('verify --dry-run reports the resolved command and source without executing or recording', () => {
+  const repo = setupRepo('node -e "process.exit(0)"');
+  const verificationPath = path.join(repo, BP_REL, 'tasks/001/verification.md');
+  const before = fs.readFileSync(verificationPath, 'utf8');
+  const { io, buf } = capture();
+
+  const code = runCli(['verify', '--repo', repo, '--blueprint', BP_REL, '--dry-run'], io);
+
+  assert.strictEqual(code, 0);
+  const result = JSON.parse(buf.out);
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.dryRun, true);
+  assert.strictEqual(result.command, 'node -e "process.exit(0)"');
+  assert.deepStrictEqual(result.source, { type: 'config', path: '.bouncer/config.json' });
+  // 실행되지 않았어야 함: verification.md가 손대지 않은 채 그대로 남는다.
+  assert.strictEqual(fs.readFileSync(verificationPath, 'utf8'), before);
+});
+
+test('verify --dry-run reports a task-declared command with its declaring path as source', () => {
+  const repo = setupRepo();
+  writeDoc(repo, `${BP_REL}/tasks/001/tasks.md`,
+    doc('bouncer.tasks', 'TASKS-001', 'verified', `${BP_REL}/tasks/001/tasks.md`, {
+      affected_paths: ['src/login.js'],
+      graph: { suggested_paths: ['src/'], basis: 'manual: src/' },
+      verify: 'node -e "process.exit(0)"',
+    }),
+    '# Tasks\n\n## Goal & intent\nx\n\n## Interface\ny\n\n'
+    + '## Touch\n`src/`\n\n## Do not touch\n`test/`\n\n## Checklist\n- [ ] z\n');
+  const { io, buf } = capture();
+
+  const code = runCli(['verify', '--repo', repo, '--blueprint', BP_REL, '--dry-run'], io);
+
+  assert.strictEqual(code, 0);
+  const result = JSON.parse(buf.out);
+  assert.strictEqual(result.command, 'node -e "process.exit(0)"');
+  assert.deepStrictEqual(result.source, { type: 'task', path: `${BP_REL}/tasks/001/tasks.md` });
+});
+
+test('verify --dry-run fails with the same code as a real run when the resolved command is invalid', () => {
+  const repo = setupRepo();
+  // task 선언 verify만 isValidVerifyCommand로 검증된다(config.verify는 셸 체이닝
