+      affected_paths: ['src/login.js'],
+      graph: { suggested_paths: ['src/'], basis: 'manual: src/' },
+      verify: 'a && b',
+    }),
+    '# Tasks\n\n## Goal & intent\nx\n\n## Interface\ny\n\n'
+    + '## Touch\n`src/`\n\n## Do not touch\n`test/`\n\n## Checklist\n- [ ] z\n');
+
+  const { io: dryIo, buf: dryBuf } = capture();
+  const dryCode = runCli(['verify', '--repo', repo, '--blueprint', BP_REL, '--dry-run'], dryIo);
+  const { io: realIo, buf: realBuf } = capture();
+  const realCode = runCli(['verify', '--repo', repo, '--blueprint', BP_REL], realIo);
+
+  assert.strictEqual(dryCode, 1);
+  assert.strictEqual(realCode, 1);
+  // CLI는 error.code가 아니라 error.message를 stderr에 낸다(catchMessage) — 두
