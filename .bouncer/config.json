{
  "source_dirs": [
    "scripts",
    "hooks"
  ],
  "context_dirs": [
    ".bouncer/context"
  ],
  "graphify": {
    "enabled": true,
    "test_dirs": [
      "test"
    ]
  },
  "distill": {
    "routing_enabled": true,
    "max_bytes": 6144
  },
  "verify": "npm test",
  "base_branch": "develop",
  "pr": {
    "draft": true,
    "base": "develop",
    "labels": [
      "bouncer"
    ]
  },
  "subagents": {
    "provider": "cursor",
    "claude": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit"
    },
    "cursor": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit"
    },
    "codex": {
      "bouncer-reviewer": "inherit",
      "bouncer-implementer": "inherit"
    }
  }
}
