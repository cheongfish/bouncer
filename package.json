{
  "name": "bouncer",
  "version": "1.6.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "agents/",
    "hooks/",
    "references/",
    "rules/",
    "resources/",
    "skills/",
    "AGENTS.md",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    ".cursor-plugin/plugin.json",
    "plugin.json"
  ],
  "description": "Deterministic core for the Bouncer plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheongfish/bouncer.git"
  },
  "homepage": "https://github.com/cheongfish/bouncer#readme",
  "bugs": {
    "url": "https://github.com/cheongfish/bouncer/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/cli"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node scripts/test-tier.js unit",
    "test:integration": "node scripts/test-tier.js integration",
    "check:emit": "node scripts/check-emit.js",
    "test:coverage": "node --test test/*.test.js --experimental-test-coverage --test-coverage-include=packages/cli/dist/** --test-coverage-lines=94 --test-coverage-branches=82 --test-coverage-functions=96",
    "ci": "npm run check:emit && npm run check:versions && npm run test:coverage && npm run test:unit && npm run lint && npm run lint:docs && npm run lint:context-comments && npm run typecheck && npm run lint:test-names && npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:docs": "node scripts/check-doc-shape.js",
    "lint:test-names": "node scripts/check-test-names.js",
    "lint:context-comments": "node scripts/check-context-comments.js",
    "setup": "git config commit.template .gitmessage && git config core.hooksPath .githooks && echo \"commit.template and core.hooksPath set — git commit (without -m) opens the team template; pre-commit runs lint and the packages/cli/dist emit check\"",
    "build": "npm run build --workspace=@cheongfish/bouncer",
    "typecheck": "tsc --noEmit -p packages/cli/tsconfig.json",
    "pretest": "npm run build",
    "verify:security": "npm test && npm audit --audit-level=high",
    "verify:strict": "npm test && npm run typecheck && npm run lint",
    "check:versions": "node scripts/sync-versions.js --check",
    "sync:versions": "node scripts/sync-versions.js --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
