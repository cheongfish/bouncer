#!/usr/bin/env bash
# 원격 CI의 빠른 스텝만 로컬 커밋에 건다. emit 검사는 check:emit 과 공유한다.
# coverage·audit 는 네트워크·시간이 커서 원격 CI(npm run ci)에 남긴다.
# 플러그인 훅(hooks/)과 섞이지 않도록 이 디렉터리는 .githooks 이다.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ ! -d node_modules ]]; then
  echo "pre-commit: node_modules 가 없습니다. 먼저 npm install 을 실행하세요." >&2
  exit 1
fi

echo "pre-commit: npm run check:emit"
npm run check:emit

echo "pre-commit: npm run lint"
npm run lint
