@@ -1,7 +1,16 @@
 import assert from 'node:assert/strict';
 import test from 'node:test';
-import { formatRow } from '../src/format.js';
+import { formatCents, formatRow } from '../src/format.js';
 
 test('formatRow joins values with tabs', () => {
   assert.equal(formatRow(['food', 2, 300]), 'food\t2\t300');
 });
+
+test('formatCents formats whole and fractional amounts', () => {
+  assert.equal(formatCents(1234), '12.34');
+  assert.equal(formatCents(-250), '-2.50');
+});
+
+test('formatCents pads single-digit cents', () => {
+  assert.equal(formatCents(1005), '10.05');
+});
