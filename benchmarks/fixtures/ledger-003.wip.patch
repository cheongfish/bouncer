diff --git a/src/format.js b/src/format.js
index 6c81898..b326a6d 100644
--- a/src/format.js
+++ b/src/format.js
@@ -1,3 +1,10 @@
 export function formatRow(values) {
   return values.join('\t');
 }
+
+// Formats integer cents as a decimal amount, e.g. 1234 -> "12.34".
+export function formatCents(cents) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  return `${sign}${Math.floor(abs / 100)}.${abs % 100}`;
+}
diff --git a/test/format.test.js b/test/format.test.js
