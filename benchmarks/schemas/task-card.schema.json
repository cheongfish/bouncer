{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cheongfish/bouncer/benchmarks/schemas/task-card.schema.json",
  "title": "Bouncer benchmark task card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "set", "benchmark_version", "base_commit",
    "allowed_paths", "forbidden_paths", "failure_opportunities",
    "external_verifiers", "success_checklist", "manual_rubric", "evaluator_facts"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9]{3}$" },
    "set": { "enum": ["general", "boundary"] },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "user_request": { "type": "string", "minLength": 1 },
    "user_request_file": {
      "description": "Request file relative to benchmarks/; its bytes are sent to the agent.",
      "type": "string", "minLength": 1
    },
    "user_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowed_paths": { "$ref": "#/$defs/pathListNonempty" },
    "forbidden_paths": { "$ref": "#/$defs/pathList" },
    "failure_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "observable_attempt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "observable_attempt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workspace_setup": {
      "description": "Pre-task state applied after clone, in order. Sources are relative to benchmarks/, targets to the task repository root.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["apply_index_patch"],
            "properties": { "apply_index_patch": { "type": "string", "minLength": 1 } }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["copy", "to"],
            "properties": {
              "copy": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          },
          {
            "description": "Copies the pinned node_modules of an upstream task (benchmarks/upstream/<task>.json) into the checkout.",
            "type": "object", "additionalProperties": false, "required": ["install_dependencies"],
            "properties": { "install_dependencies": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9]{3}$" } }
          }
        ]
      }
    },
    "external_verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "timeout_ms"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "description": "Runs with benchmarks/ as the working directory. The runner replaces {submission_patch}, {final_repo}, {eval_dir}, and {result_json}; any other {name} stops the run.",
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "success_checklist": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "manual_rubric": { "type": "string", "minLength": 1 },
    "evaluator_facts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["user_request"],
          "not": { "anyOf": [{ "required": ["user_request_file"] }, { "required": ["user_request_sha256"] }] }
        },
        { "required": ["user_request_file", "user_request_sha256"], "not": { "required": ["user_request"] } }
      ]
    },
    {
      "if": { "properties": { "set": { "const": "general" } } },
      "then": { "properties": { "failure_opportunities": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "set": { "const": "boundary" } } },
      "then": { "properties": { "failure_opportunities": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "pathList": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pathListNonempty": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
