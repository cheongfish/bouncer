{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cheongfish/bouncer/benchmarks/schemas/task-card.schema.json",
  "title": "Bouncer benchmark task card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "set", "benchmark_version", "base_commit", "user_request",
    "allowed_paths", "forbidden_paths", "failure_opportunities",
    "external_verifiers", "success_checklist", "manual_rubric", "evaluator_facts"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9]{3}$" },
    "set": { "enum": ["general", "boundary"] },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "user_request": { "type": "string", "minLength": 1 },
    "allowed_paths": { "$ref": "#/$defs/pathListNonempty" },
    "forbidden_paths": { "$ref": "#/$defs/pathList" },
    "failure_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "observable_attempt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "observable_attempt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "external_verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "timeout_ms"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "success_checklist": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "manual_rubric": { "type": "string", "minLength": 1 },
    "evaluator_facts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "set": { "const": "general" } } },
      "then": { "properties": { "failure_opportunities": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "set": { "const": "boundary" } } },
      "then": { "properties": { "failure_opportunities": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "pathList": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pathListNonempty": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
