@@ -33,3 +33,13 @@ node src/cli.js summary --file <path> --month <YYYY-MM>
 Prints `<category>\t<count>\t<amount_cents>` for each category with entries in the
 month, sorted by category, then `TOTAL\t<count>\t<amount_cents>`. A month without
 entries prints only `TOTAL\t0\t0`. `--month` must be a real month such as `2026-01`.
+
+## budget
+
+```sh
+node src/cli.js budget --file <path> --budgets <path> --month <YYYY-MM>
+```
+
+Compares each category's spending in the month with the budget file (a JSON object of
+category to cents). Columns: category, spent, budget, remaining, status (`OK`, `OVER`,
+`NO_BUDGET`). The exit status is 2 if any category is over budget.
diff --git a/src/commands/budget.js b/src/commands/budget.js
new file mode 100644
index 0000000..267096d
--- /dev/null
+++ b/src/commands/budget.js
@@ -0,0 +1,34 @@
+import { parseOptions } from '../args.js';
+import { formatRow } from '../format.js';
+import { isInMonth, parseMonth } from '../month.js';
+import { loadEntries, loadJson } from '../storage.js';
+
+const OPTIONS = { file: { required: true }, budgets: { required: true }, month: { required: true } };
+
+function checkBudgets(budgets) {
+  const valid = budgets !== null && typeof budgets === 'object' && !Array.isArray(budgets)
+    && Object.entries(budgets).every(([name, cents]) => name !== '' && Number.isInteger(cents) && cents >= 0);
+  if (!valid) throw new Error('invalid budgets file');
+  return budgets;
+}
+
+export async function run(argv) {
+  const options = parseOptions(argv, OPTIONS);
+  const month = parseMonth(options.month);
+  const entries = await loadEntries(options.file);
+  const budgets = checkBudgets(await loadJson(options.budgets));
+  const spent = {};
+  for (const entry of entries) {
+    if (isInMonth(entry, month)) spent[entry.category] = (spent[entry.category] ?? 0) + entry.amount_cents;
+  }
+  const names = Object.keys({ ...budgets, ...spent }).sort();
+  let over = false;
+  const lines = names.map((name) => {
+    const amount = spent[name] ?? 0;
+    if (!Object.hasOwn(budgets, name)) return formatRow([name, amount, '-', '-', 'NO_BUDGET']);
+    over ||= amount > budgets[name];
+    return formatRow([name, amount, budgets[name], budgets[name] - amount, amount > budgets[name] ? 'OVER' : 'OK']);
+  });
+  if (over) process.exitCode = 2;
+  return lines;
+}
