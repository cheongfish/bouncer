@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareBudgets, validateBudgets } from '../src/budgets.js';
+import { runCli, writeTempJson, fixturePath } from './helpers.js';
+
+test('validateBudgets rejects non-objects and invalid amounts', () => {
+  assert.throws(() => validateBudgets([]), /JSON object/);
+  assert.throws(() => validateBudgets({ food: -1 }), /invalid/);
+  assert.throws(() => validateBudgets({ food: 1.5 }), /invalid/);
+  assert.throws(() => validateBudgets({ '': 1 }), /empty/);
+});
+
+test('compareBudgets covers budgeted and spent categories', () => {
+  const rows = compareBudgets([{ category: 'food', count: 1, amountCents: 300 }], new Map([['books', 100], ['food', 200]]));
+  assert.deepEqual(rows.map((row) => row.status), ['OK', 'OVER']);
+});
+
+test('budget exits 2 when a category is over budget', async () => {
+  const budgets = await writeTempJson({ food: 1000 });
+  const result = await runCli(['budget', '--file', fixturePath('entries.json'), '--budgets', budgets, '--month', '2026-01']);
+  assert.equal(result.code, 0);
+  assert.equal(result.stdout, 'books\t0\t-\t-\tNO_BUDGET\nfood\t1550\t1000\t-550\tOVER\ntravel\t800\t-\t-\tNO_BUDGET\n');
+});
