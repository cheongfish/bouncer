@@ -0,0 +1,19 @@
+import { summarizeByCategory } from '../aggregate.js';
+import { parseOptions } from '../args.js';
+import { compareBudgets, loadBudgets } from '../budgets.js';
+import { formatRow } from '../format.js';
+import { isInMonth, parseMonth } from '../month.js';
+import { loadEntries } from '../storage.js';
+
+const OPTIONS = { file: { required: true }, budgets: { required: true }, month: { required: true } };
+
+export async function run(argv) {
+  const options = parseOptions(argv, OPTIONS);
+  const month = parseMonth(options.month);
+  const entries = (await loadEntries(options.file)).filter((entry) => isInMonth(entry, month));
+  const rows = compareBudgets(summarizeByCategory(entries), await loadBudgets(options.budgets));
+  return {
+    lines: rows.map((row) => formatRow([row.category, row.spent, row.budget ?? '-', row.remaining ?? '-', row.status])),
+    exitCode: 0,
+  };
+}
