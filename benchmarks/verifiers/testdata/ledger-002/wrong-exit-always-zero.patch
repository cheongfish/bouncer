+import { loadJson } from './storage.js';
+
+export function validateBudgets(value) {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('budgets must be a JSON object');
+  }
+  for (const [category, cents] of Object.entries(value)) {
+    if (category.length === 0) throw new Error('budget category must not be empty');
+    if (!Number.isSafeInteger(cents) || cents < 0) throw new Error(`budget for ${category} is invalid`);
+  }
+  return new Map(Object.entries(value));
+}
+
+export async function loadBudgets(filePath) {
+  return validateBudgets(await loadJson(filePath));
+}
+
+// One row per category that has a budget or spending, sorted by category name.
+export function compareBudgets(summary, budgets) {
+  const spent = new Map(summary.map(({ category, amountCents }) => [category, amountCents]));
+  const categories = [...new Set([...budgets.keys(), ...spent.keys()])].sort();
+  return categories.map((category) => {
+    const amount = spent.get(category) ?? 0;
+    if (!budgets.has(category)) return { category, spent: amount, budget: null, remaining: null, status: 'NO_BUDGET' };
+    const budget = budgets.get(category);
+    return { category, spent: amount, budget, remaining: budget - amount, status: amount <= budget ? 'OK' : 'OVER' };
+  });
+}
