+
+test('parseOptions accepts an alias as the same option', () => {
+  const spec = { file: { required: true, alias: 'f' } };
+  assert.deepEqual(parseOptions(['-f', 'a.json'], spec), { file: 'a.json' });
+  assert.throws(() => parseOptions(['-f', 'a.json', '--file', 'b.json'], spec), /duplicate/);
