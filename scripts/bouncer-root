#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');

// 빌드 전 checkout에서 MODULE_NOT_FOUND stack trace가 나오면 복구 방법이
// 안 보인다. 자동 빌드하지 않는 이유는 launcher가 npm 수명주기를 가지면
// 설치본·hook 경로까지 빌드를 시도하기 때문이다. 존재 확인만 한다.
const libEntry = path.join(__dirname, 'lib', 'bouncer-root.js');
if (!fs.existsSync(libEntry)) {
  process.stderr.write(
    `bouncer: scripts/lib is missing; run \`npm run build\` in ${path.dirname(__dirname)}\n`,
  );
  process.exit(1);
}

const { runBouncerRoot } = require('./lib/bouncer-root');
process.exit(runBouncerRoot(process.argv.slice(2)));
