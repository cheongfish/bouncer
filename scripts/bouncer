#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

function realpath(file) {
  try {
    return fs.realpathSync(file);
  } catch {
    return path.resolve(file);
  }
}

function bouncerRootCommand() {
  const pathEntries = (process.env.PATH || '').split(path.delimiter).filter(Boolean);
  for (const entry of pathEntries) {
    const candidate = path.join(entry, 'bouncer-root');
    if (fs.existsSync(candidate)) return { file: 'bouncer-root', args: ['--auto'] };
  }
  // PATH가 정리된 격리 셸에서도 패키지와 함께 배포된 보조 런처를 한 번만 해석한다.
  return { file: process.execPath, args: [path.join(__dirname, 'bouncer-root'), '--auto'] };
}

function resolveInstalledRoot() {
  // bouncer-root에 우선순위 규칙을 위임해 두 런처가 독립 셸에서 같은 설치본을 고른다.
  const command = bouncerRootCommand();
  const result = spawnSync(command.file, command.args, {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'inherit'],
  });
  if (result.error) {
    process.stderr.write(`bouncer: could not resolve plugin root: ${result.error.message}\n`);
    return null;
  }
  if (result.status !== 0) return null;
  const output = (result.stdout || '').trim();
  if (!output) {
    process.stderr.write('bouncer: bouncer-root returned an empty plugin root\n');
    return null;
  }
  return output;
}

// plugin root 해석 없이 launcher 자신의 CLI로 실행하는 명령. 첫 인자가 정확히 일치할 때만 적용한다.
const PURE_COMMANDS = new Set(['commit-guard', 'current', 'project-root', 'validate', 'verify', 'graph-sync']);

/**
 * 이 launcher가 속한 트리의 CLI를 실행한다. 자기 실행 분기와 순수 명령 분기가 같은 검사
 * (lib/cli.js 존재, 개발 checkout 신선도)와 같은 오류 문구를 쓰도록 한 곳에 둔다.
 *
 * @param {string[]} argv - process.argv에서 node와 스크립트 경로를 뺀 나머지
 * @returns {number} CLI 종료 코드. lib 부재·stale-build면 1
 */
function runOwnCli(argv) {
  const cliEntry = path.join(__dirname, 'lib', 'cli.js');
  // 자동 빌드하지 않는다. launcher가 npm 수명주기를 가지면 설치본·hook
  // 경로까지 빌드를 시도하고, 개발 checkout의 복구 안내는 한 줄이면 충분하다.
  if (!fs.existsSync(cliEntry)) {
    process.stderr.write(
      `bouncer: scripts/lib is missing; run \`npm run build\` in ${path.dirname(__dirname)}\n`,
    );
    return 1;
  }
  // 개발 checkout(scripts/src 존재)에서만 산출물 신선도를 본다. 배포본은 소스가
  // 없고 helper도 없을 수 있어 require하지 않는다.
  const sourceDir = path.join(__dirname, 'src');
  if (fs.existsSync(sourceDir) && !require('./build-stamp').checkBuildFresh(path.dirname(__dirname)).ok) {
    process.stderr.write(
      `bouncer: stale-build: scripts/lib does not match scripts/src; run \`npm run build\` in ${path.dirname(__dirname)}\n`,
    );
    return 1;
  }
  const { runCli } = require('./lib/cli');
  return runCli(argv);
}

/**
 * 최고 우선순위 설치본의 CLI를 실행한다. 순수 명령(PURE_COMMANDS)은 설치본을 찾지 않고
 * 자기 CLI를 실행한다. 그 밖의 명령은 자신이 그 설치본이면 바로 실행하고, 아니면 그
 * 설치본 launcher로 위임한다. 위임 분기는 자기 lib 부재를 보지 않는다 —
 * 대상 설치본이 안내용 메시지를 낼지, 빌드된 트리를 갖고 있는지는 그쪽
 * launcher의 책임이다.
 *
 * @param {string[]} argv - process.argv에서 node와 스크립트 경로를 뺀 나머지
 * @returns {number} CLI 또는 자식 프로세스 종료 코드
 */
function runLauncher(argv) {
  // 저장소·게이트 명령은 plugin 자산을 읽지 않으므로 root를 찾지 않고 이 launcher의 CLI로
  // 바로 실행한다. 훅이 넘기는 BOUNCER_HOME이 무효여도 commit 판정이 막히지 않게 하려는 것이다.
  if (PURE_COMMANDS.has(argv[0])) return runOwnCli(argv);

  const root = resolveInstalledRoot();
  if (!root) return 1;

  const target = path.join(root, 'scripts', 'bouncer');
  // 최고 우선순위 설치본이 자신이면 재실행하지 않고 현재 CLI를 바로 실행한다.
  if (realpath(target) === realpath(__filename)) return runOwnCli(argv);

  const result = spawnSync(process.execPath, [target, ...argv], { stdio: 'inherit' });
  if (result.error) {
    process.stderr.write(`bouncer: could not run ${target}: ${result.error.message}\n`);
    return 1;
  }
  if (result.status !== null) return result.status;
  const signalNumber = result.signal ? os.constants.signals[result.signal] : undefined;
  return signalNumber ? 128 + signalNumber : 1;
}

if (require.main === module) process.exit(runLauncher(process.argv.slice(2)));
module.exports = { runLauncher };
